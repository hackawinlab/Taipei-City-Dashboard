# TDX API credentials (apply at https://tdx.transportdata.tw)
# Required for New Taipei City data; Taipei City uses public blob (no auth needed)
TDX_CLIENT_ID=your_client_id_here
TDX_CLIENT_SECRET=your_client_secret_here

# Optional overrides (defaults shown)
# BUS_DATA_DIR=./data
# DASHBOARD_DB_HOST=localhost
# DASHBOARD_DB_PORT=5433
# DASHBOARD_DB_NAME=dashboard
# DASHBOARD_DB_USER=postgres
# DASHBOARD_DB_PASS=postgres
# DASHBOARD_FE_PUBLIC=/path/to/Taipei-City-Dashboard-FE/public
